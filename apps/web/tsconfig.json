{
  "compilerOptions": {
    "target": "ES2022", "useDefineForClassFields": true, "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "allowImportingTsExtensions": false,
    "strict": true, "noUncheckedIndexedAccess": true, "noEmit": true, "jsx": "react-jsx", "skipLibCheck": true,
    "composite": true
  },
  "references": [{ "path": "../../packages/shared" }],
  "include": ["src", "vite.config.ts"]
}
